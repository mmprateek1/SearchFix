# Each request must supply the user's key; GEMINI_API_KEY is not read.
# Model order is defined in src/config/modelFallbacks.js.
# Legacy GEMINI_COMMENT_MODEL / GEMINI_DOCUMENT_MODEL settings are ignored.
PORT=3000
# Required on Render/production: comma-separated SHA-256 fingerprints.
# Generate each with: node scripts/hash-gemini-key.mjs
# ALLOWED_GEMINI_KEY_HASHES=
# RPM/TPM/RPD budgets are configured in config/gemini-rate-limits.json.
